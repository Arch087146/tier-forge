<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration: windows-installers

  The workflow uploads TierForge-setup.exe (NSIS) and TierForge.msi at the root
  of a GitHub Actions artifact, so the root element is <zip-file>.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="TierForge-setup.exe">
      <authenticode-sign />
    </pe-file>
    <msi-file path="TierForge.msi">
      <authenticode-sign />
    </msi-file>
  </zip-file>
</artifact-configuration>
