<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration: windows-exe

  Create this configuration in the SignPath project after approval, or paste
  this file into the artifact configuration editor. The workflow uploads the
  unsigned application as a GitHub Actions artifact (a ZIP containing
  TierForge.exe at the root), so the root element is <zip-file>.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="TierForge.exe">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
